# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/stock_management

# MongoDB Atlas (replace user, password and cluster host)
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net

# Database name. Used when the connection string does not contain one,
# which is the case for most Atlas connection strings.
MONGODB_DB=stock_management

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Manager accounts
AUTH_MOHSEN_USERNAME=Mohsen
AUTH_MOHSEN_PASSWORD=manager123
AUTH_MOHSEN_DISPLAY_NAME=محسن

AUTH_AHMED_USERNAME=Ahmed
AUTH_AHMED_PASSWORD=manager123
AUTH_AHMED_DISPLAY_NAME=أحمد

# Accountant account (no access to partners module)
AUTH_ACCOUNTANT_USERNAME=accountant
AUTH_ACCOUNTANT_PASSWORD=accountant123
AUTH_ACCOUNTANT_DISPLAY_NAME=المحاسب
